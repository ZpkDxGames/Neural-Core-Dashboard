{
  "name": "neural-core",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "test:auth-ui": "playwright test",
    "test:brain": "node --experimental-strip-types --test tests/brain/*.test.ts tests/brain/*.test.mjs",
    "lint": "node scripts/lint-brain-tokens.mjs",
    "test:vault": "node --test backend/v2/note.test.mjs backend/v2/vault.test.mjs backend/v2/api.test.mjs",
    "test:vault:integration": "node --test backend/v2/integration.test.mjs",
    "test:private": "node --experimental-strip-types --test tests/private/deadline.test.mjs tests/private/assertions.test.mjs tests/private/adapter.test.mjs tests/private/bff.test.mjs tests/private/oidc.test.mjs tests/private/owner-access.test.mjs",
    "test:private:integration": "node --experimental-strip-types --test tests/private/integration.test.mjs",
    "test:private:browser": "playwright test --config playwright.private.config.mjs"
  },
  "dependencies": {
    "@upstash/redis": "1.39.0",
    "lucide-react": "^0.468.0",
    "next": "^16.1.0",
    "openid-client": "6.8.8",
    "pg": "^8.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "three": "^0.180.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.62.1",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
